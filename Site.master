<%@ Master Language="VB" AutoEventWireup="false" CodeBehind="Site.master.vb" Inherits="SISCONBOL_FLORERIA.Site" %>
<!DOCTYPE html>
<html lang="es">
<head runat="server">
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><asp:ContentPlaceHolder ID="TitleContent" runat="server">SISCONBOL</asp:ContentPlaceHolder></title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
<link rel="stylesheet" href="<%= ResolveUrl("~/Estilos/site.css") %>" type="text/css">
<script src="<%= ResolveUrl("~/Scripts/site.js") %>" type="text/javascript"></script>
<asp:ContentPlaceHolder ID="HeadContent" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
<form id="form1" runat="server">
<div class="overlay" id="overlay" onclick="cerrarSidebar()"></div>
<div class="layout">

  <!-- SIDEBAR -->
  <aside class="sidebar" id="sidebar">
    <div class="sb-logo">
      <div class="sb-logo-title">Floreria</div>
      <div class="sb-logo-sub">Sistema Integral</div>
    </div>
    <div class="sb-user">
      <div class="sb-avatar" id="spIniciales">--</div>
      <div>
        <div class="sb-user-name" id="spNombre">Cargando...</div>
        <div class="sb-user-role"  id="spRol"></div>
        <div class="sb-sesion">Sesion hasta 23:59</div>
      </div>
    </div>
    <nav class="nav">
      <%=MenuHtml%>
    </nav>
    <div class="sb-footer">
      <input type="hidden" id="hdCerrar" name="hdCerrar" value="0"/>
      <asp:Button ID="btnCerrarSesion" runat="server" Text=""
          Style="display:none" OnClick="btnCerrarSesion_Click"/>
    </div>
  </aside>

  <!-- MAIN -->
  <div class="main">
    <header class="topbar">
      <button class="hamburger" onclick="abrirSidebar()" type="button">
        <i class="ti ti-menu-2" style="font-size:22px" aria-hidden="true"></i>
      </button>
      <div class="topbar-title" id="spTituloPagina">
        <asp:ContentPlaceHolder ID="PageTitleContent" runat="server">Inicio</asp:ContentPlaceHolder>
      </div>

      <!-- AVATAR CON MENU DESPLEGABLE -->
      <div class="avatar-wrap">
        <button type="button" class="avatar-btn" onclick="toggleAvatarMenu()" id="btnAvatar">
          <div class="avatar-top" id="spInicialesTop">--</div>
          <div class="avatar-info">
            <div class="avatar-name" id="spNombreTop">Cargando...</div>
            <div class="avatar-role" id="spRolTop"></div>
          </div>
          <i class="ti ti-chevron-down" style="font-size:13px;color:#9e9e9e;margin-left:2px" aria-hidden="true"></i>
        </button>
        <div class="avatar-menu" id="avatarMenu">
          <a class="avatar-menu-item" href="<%= ResolveUrl("~/CambiarPassword.aspx") %>">
            <i class="ti ti-lock" style="font-size:16px;color:#9e9e9e" aria-hidden="true"></i>
            Cambiar contrasena
          </a>
          <button type="button" class="avatar-menu-item danger" onclick="cerrarSesion()">
            <i class="ti ti-logout" style="font-size:16px" aria-hidden="true"></i>
            Cerrar sesion
          </button>
        </div>
      </div>
    </header>

    <div class="contenido">
      <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
    </div>
  </div>

</div>

<!-- Hidden button para cerrar sesión -->
<asp:Button ID="btnCerrarSesionHidden" runat="server" Style="display:none" />

</form>

<script type="text/javascript">
// @ts-nocheck
// Cargar datos de usuario desde Session
(function() {
    var nombres   = '<%= If(Session("nombres")     IsNot Nothing, Session("nombres").ToString(),     "") %>';
    var apellidos = '<%= If(Session("apellidos")   IsNot Nothing, Session("apellidos").ToString(),   "") %>';
    var rol       = '<%= If(Session("tipo_nombre") IsNot Nothing, Session("tipo_nombre").ToString(), "") %>';
    var iniciales = (nombres.charAt(0) + apellidos.charAt(0)).toUpperCase();

    var elNombre       = document.getElementById('spNombre');
    var elRol          = document.getElementById('spRol');
    var elInic         = document.getElementById('spIniciales');
    var elNombreTop    = document.getElementById('spNombreTop');
    var elRolTop       = document.getElementById('spRolTop');
    var elInicialesTop = document.getElementById('spInicialesTop');

    if (elNombre)       { elNombre.textContent       = nombres + ' ' + apellidos; }
    if (elRol)          { elRol.textContent          = rol; }
    if (elInic)         { elInic.textContent         = iniciales; }
    if (elNombreTop)    { elNombreTop.textContent    = nombres + ' ' + apellidos; }
    if (elRolTop)       { elRolTop.textContent       = rol; }
    if (elInicialesTop) { elInicialesTop.textContent = iniciales; }
})();

// Sobrescribir cerrarSesion para usar el botón del master
function cerrarSesion() {
    var elHd  = /** @type {HTMLInputElement} */ (document.getElementById('hdCerrar'));
    var elBtn = document.getElementById('<%= btnCerrarSesion.ClientID %>');
    if (elHd) { elHd.value = '1'; }
    if (elBtn) { elBtn.click(); }
}
</script>
<asp:ContentPlaceHolder ID="ScriptsContent" runat="server"></asp:ContentPlaceHolder>
</body>
</html>
